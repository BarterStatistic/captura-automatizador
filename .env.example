# Copia este archivo como .env.local y pega tu clave de Gemini.
# Se consigue en https://aistudio.google.com/apikey
#
# Solo la lee el servidor (/api/gemini); nunca se compila en la página.
# En Vercel va en Settings → Environment Variables con el mismo nombre.
GEMINI_API_KEY=

# Opcional: otro modelo de Gemini. Por defecto gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
